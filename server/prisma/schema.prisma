generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_KYC
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum SlotStatus {
  ACTIVE
  OPEN_NOW
  DRAW_DONE
  CLOSED
}

enum BatchStatus {
  OPEN
  LOCKED
}

enum TicketStatus {
  AVAILABLE
  SOLD
  WINNER
  CANCELLED
}

enum CommissionBase {
  SEM_VALUE
  PRICE
  FLAT
}

enum PayoutMode {
  INSTANT
  BATCH
}

enum ShortfallPolicy {
  FORFEIT
  ROLLUP_TO_ADMIN
}

enum CommissionStatus {
  PENDING
  PAID
  REVERSED
}

enum WalletTxnType {
  COMMISSION
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTxnStatus {
  PENDING
  COMPLETED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PrizeTier {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
}

model User {
  id              Int        @id @default(autoincrement())
  name            String
  email           String     @unique
  mobile          String
  whatsapp        String?
  passwordHash    String     @map("password_hash")
  role            Role
  sponsorId       Int?       @map("sponsor_id")
  sponsor         User?      @relation("UserSponsor", fields: [sponsorId], references: [id])
  downline        User[]     @relation("UserSponsor")
  referralCode    String     @unique @map("referral_code")
  status          UserStatus @default(PENDING_KYC)
  isCompanyWallet Boolean    @default(false) @map("is_company_wallet")
  walletBalance   Decimal    @default(0) @db.Decimal(12, 2) @map("wallet_balance")
  kycDocUrl       String?    @map("kyc_doc_url")
  approvedById    Int?       @map("approved_by_id")
  approvedBy      User?      @relation("UserApprovedBy", fields: [approvedById], references: [id])
  approvedUsers   User[]     @relation("UserApprovedBy")
  approvedAt      DateTime?  @map("approved_at")
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  createdBatches       TicketBatch[]       @relation("BatchCreatedBy")
  ticketsSold          Ticket[]            @relation("TicketSoldByAgent")
  customersCreated     Customer[]          @relation("CustomerCreatedByAgent")
  receipts             Receipt[]           @relation("ReceiptAgent")
  drawResultsDeclared  DrawResult[]        @relation("ResultDeclaredBy")
  commissionsEarned    CommissionLedger[]  @relation("CommissionEarner")
  commissionsSourced   CommissionLedger[]  @relation("CommissionSource")
  walletTransactions   WalletTransaction[]
  withdrawalRequests   WithdrawalRequest[] @relation("WithdrawalUser")
  withdrawalsProcessed WithdrawalRequest[] @relation("WithdrawalProcessedBy")
  auditLogs            AuditLog[]
  paymentMethodsCreated PaymentMethod[]    @relation("PaymentMethodCreatedBy")

  @@index([sponsorId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model DrawSlot {
  id            Int        @id @default(autoincrement())
  name          String
  salesOpenTime DateTime   @db.Time(0) @map("sales_open_time")
  drawCloseTime DateTime   @db.Time(0) @map("draw_close_time")
  isActive      Boolean    @default(true) @map("is_active")
  status        SlotStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  ticketBatches TicketBatch[]
  tickets       Ticket[]
  receipts      Receipt[]
  drawResults   DrawResult[]

  @@index([status])
  @@map("draw_slots")
}

model Series {
  id         Int          @id @default(autoincrement())
  name       String
  multiplier Decimal      @db.Decimal(10, 2)
  basePrice  Decimal      @db.Decimal(10, 2) @map("base_price")
  status     ActiveStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  ticketBatches TicketBatch[]
  tickets       Ticket[]

  @@index([status])
  @@map("series")
}

model TicketBatch {
  id             Int         @id @default(autoincrement())
  batchCode      String      @unique @map("batch_code")
  drawSlotId     Int         @map("draw_slot_id")
  drawSlot       DrawSlot    @relation(fields: [drawSlotId], references: [id])
  drawDate       DateTime    @db.Date @map("draw_date")
  seriesId       Int         @map("series_id")
  series         Series      @relation(fields: [seriesId], references: [id])
  prefix         String
  startNumber    Int         @map("start_number")
  quantity       Int
  pricePerTicket Decimal     @db.Decimal(10, 2) @map("price_per_ticket")
  totalSemValue  Decimal     @db.Decimal(14, 2) @map("total_sem_value")
  status         BatchStatus @default(OPEN)
  createdById    Int         @map("created_by")
  createdBy      User        @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now()) @map("created_at")

  tickets Ticket[]

  @@index([drawSlotId, drawDate])
  @@index([seriesId])
  @@index([status])
  @@map("ticket_batches")
}

model Ticket {
  id               Int          @id @default(autoincrement())
  batchId          Int          @map("batch_id")
  batch            TicketBatch  @relation(fields: [batchId], references: [id])
  ticketNumber     String       @unique @map("ticket_number")
  drawSlotId       Int          @map("draw_slot_id")
  drawSlot         DrawSlot     @relation(fields: [drawSlotId], references: [id])
  drawDate         DateTime     @db.Date @map("draw_date")
  seriesId         Int          @map("series_id")
  series           Series       @relation(fields: [seriesId], references: [id])
  status           TicketStatus @default(AVAILABLE)
  semValue         Decimal      @db.Decimal(12, 2) @map("sem_value")
  price            Decimal      @db.Decimal(10, 2)
  soldByAgentId    Int?         @map("sold_by_agent_id")
  soldByAgent      User?        @relation("TicketSoldByAgent", fields: [soldByAgentId], references: [id])
  soldToCustomerId Int?         @map("sold_to_customer_id")
  soldToCustomer   Customer?    @relation(fields: [soldToCustomerId], references: [id])
  soldAt           DateTime?    @map("sold_at")
  receiptId        Int?         @map("receipt_id")
  receipt          Receipt?     @relation(fields: [receiptId], references: [id])

  firstPrizeFor           DrawResult?        @relation("FirstPrizeTicket")
  winnerEntries           DrawResultWinner[] @relation("TicketWinnerEntry")
  commissionLedgerEntries CommissionLedger[]

  @@index([status])
  @@index([drawSlotId, drawDate, seriesId, status])
  @@index([soldByAgentId])
  @@index([soldToCustomerId])
  @@index([receiptId])
  @@map("tickets")
}

model Customer {
  id               Int      @id @default(autoincrement())
  name             String
  mobile           String
  whatsapp         String?
  email            String?
  createdByAgentId Int      @map("created_by_agent_id")
  createdByAgent   User     @relation("CustomerCreatedByAgent", fields: [createdByAgentId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  tickets  Ticket[]
  receipts Receipt[]

  @@unique([createdByAgentId, mobile])
  @@index([mobile])
  @@map("customers")
}

model Receipt {
  id              Int           @id @default(autoincrement())
  receiptCode     String        @unique @map("receipt_code")
  agentId         Int           @map("agent_id")
  agent           User          @relation("ReceiptAgent", fields: [agentId], references: [id])
  customerId      Int           @map("customer_id")
  customer        Customer      @relation(fields: [customerId], references: [id])
  drawSlotId      Int           @map("draw_slot_id")
  drawSlot        DrawSlot      @relation(fields: [drawSlotId], references: [id])
  drawDate        DateTime      @db.Date @map("draw_date")
  totalTickets    Int           @map("total_tickets")
  totalSemValue   Decimal       @db.Decimal(14, 2) @map("total_sem_value")
  totalAmount     Decimal       @db.Decimal(14, 2) @map("total_amount")
  paymentMethodId Int           @map("payment_method_id")
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  transactionId   String        @unique @map("transaction_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  tickets          Ticket[]
  commissionLedger CommissionLedger[]

  @@index([agentId])
  @@index([customerId])
  @@index([drawSlotId, drawDate])
  @@index([paymentMethodId])
  @@map("receipts")
}

// Admin-managed UPI/QR payment targets. Agents pay the active one out-of-band (their own UPI
// app) and prove it by entering the transaction id/UTR when completing a sale — see Receipt.
model PaymentMethod {
  id          Int      @id @default(autoincrement())
  label       String
  upiId       String   @map("upi_id")
  qrImage     String   @db.Text @map("qr_image") // data URI (uploaded QR image) or hosted URL
  isActive    Boolean  @default(false) @map("is_active")
  createdById Int      @map("created_by")
  createdBy   User     @relation("PaymentMethodCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  receipts Receipt[]

  @@index([isActive])
  @@map("payment_methods")
}

// A single declared result for one draw occurrence (slot + date). The 1st prize is tied to one
// actual sold ticket; 2nd-5th prizes are number *patterns* (not specific tickets) matched against
// the last N digits of every sold ticket's number in that slot/date — same mechanic as real
// state-lottery draws, where many tickets across different series can share a winning ending.
model DrawResult {
  id         Int      @id @default(autoincrement())
  drawName   String   @map("draw_name")
  drawNumber String   @map("draw_number")
  drawSlotId Int      @map("draw_slot_id")
  drawSlot   DrawSlot @relation(fields: [drawSlotId], references: [id])
  drawDate   DateTime @db.Date @map("draw_date")

  firstPrizeTicketId Int     @unique @map("first_prize_ticket_id")
  firstPrizeTicket   Ticket  @relation("FirstPrizeTicket", fields: [firstPrizeTicketId], references: [id])
  firstPrizeAmount   Decimal @db.Decimal(12, 2) @map("first_prize_amount")

  secondPrizeAmount  Decimal @db.Decimal(12, 2) @map("second_prize_amount")
  secondPrizeNumbers Json    @map("second_prize_numbers") // string[] of unique 5-digit patterns

  thirdPrizeAmount  Decimal @db.Decimal(12, 2) @map("third_prize_amount")
  thirdPrizeNumbers Json    @map("third_prize_numbers") // string[] of unique 4-digit patterns

  fourthPrizeAmount  Decimal @db.Decimal(12, 2) @map("fourth_prize_amount")
  fourthPrizeNumbers Json    @map("fourth_prize_numbers") // string[] of unique 4-digit patterns

  fifthPrizeAmount     Decimal @db.Decimal(12, 2) @map("fifth_prize_amount")
  fifthPrizePercentage Decimal @db.Decimal(5, 2) @map("fifth_prize_percentage")
  fifthPrizeNumbers    Json    @map("fifth_prize_numbers") // string[] of unique 4-digit patterns

  declaredById Int      @map("declared_by")
  declaredBy   User     @relation("ResultDeclaredBy", fields: [declaredById], references: [id])
  declaredAt   DateTime @default(now()) @map("declared_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  winners DrawResultWinner[]

  @@index([drawSlotId, drawDate])
  @@map("draw_results")
}

// One row per ticket that actually won something in a declared result (computed at declare/edit
// time from the patterns above). Keeps per-ticket winner tracking for the ticket grid, Prize
// Winners, and My Winners pages without re-deriving pattern matches on every read.
model DrawResultWinner {
  id           Int       @id @default(autoincrement())
  drawResultId Int       @map("draw_result_id")
  drawResult   DrawResult @relation(fields: [drawResultId], references: [id])
  ticketId     Int       @map("ticket_id")
  ticket       Ticket    @relation("TicketWinnerEntry", fields: [ticketId], references: [id])
  prizeTier    PrizeTier @map("prize_tier")
  prizeAmount  Decimal   @db.Decimal(12, 2) @map("prize_amount")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([drawResultId, ticketId])
  @@index([ticketId])
  @@index([drawResultId, prizeTier])
  @@map("draw_result_winners")
}

model MlmSettings {
  id                 Int             @id @default(autoincrement())
  maxLevels          Int             @map("max_levels")
  commissionBase     CommissionBase  @default(SEM_VALUE) @map("commission_base")
  flatAmount         Decimal?        @db.Decimal(10, 2) @map("flat_amount")
  payoutMode         PayoutMode      @default(INSTANT) @map("payout_mode")
  minPayoutThreshold Decimal         @default(0) @db.Decimal(10, 2) @map("min_payout_threshold")
  shortfallPolicy    ShortfallPolicy @default(ROLLUP_TO_ADMIN) @map("shortfall_policy")
  effectiveFrom      DateTime        @default(now()) @map("effective_from")
  effectiveTo        DateTime?       @map("effective_to")
  createdAt          DateTime        @default(now()) @map("created_at")

  levelPercentages MlmLevelPercentage[]

  @@index([effectiveFrom, effectiveTo])
  @@map("mlm_settings")
}

model MlmLevelPercentage {
  id            Int         @id @default(autoincrement())
  mlmSettingsId Int         @map("mlm_settings_id")
  mlmSettings   MlmSettings @relation(fields: [mlmSettingsId], references: [id])
  levelNumber   Int         @map("level_number")
  percentage    Decimal     @db.Decimal(5, 2)

  @@unique([mlmSettingsId, levelNumber])
  @@map("mlm_level_percentages")
}

model CommissionLedger {
  id                Int              @id @default(autoincrement())
  receiptId         Int              @map("receipt_id")
  receipt           Receipt          @relation(fields: [receiptId], references: [id])
  ticketId          Int              @map("ticket_id")
  ticket            Ticket           @relation(fields: [ticketId], references: [id])
  earningAgentId    Int              @map("earning_agent_id")
  earningAgent      User             @relation("CommissionEarner", fields: [earningAgentId], references: [id])
  sourceAgentId     Int              @map("source_agent_id")
  sourceAgent       User             @relation("CommissionSource", fields: [sourceAgentId], references: [id])
  levelNumber       Int              @map("level_number")
  semValue          Decimal          @db.Decimal(12, 2) @map("sem_value")
  percentageApplied Decimal          @db.Decimal(5, 2) @map("percentage_applied")
  commissionAmount  Decimal          @db.Decimal(12, 2) @map("commission_amount")
  status            CommissionStatus @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  paidAt            DateTime?        @map("paid_at")

  @@index([earningAgentId])
  @@index([sourceAgentId])
  @@index([receiptId])
  @@index([ticketId])
  @@index([status])
  @@index([earningAgentId, createdAt])
  @@map("commission_ledger")
}

model WalletTransaction {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("user_id")
  user         User            @relation(fields: [userId], references: [id])
  type         WalletTxnType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2) @map("balance_after")
  refId        String?         @map("ref_id")
  status       WalletTxnStatus @default(COMPLETED)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  user          User             @relation("WithdrawalUser", fields: [userId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  status        WithdrawalStatus @default(PENDING)
  requestedAt   DateTime         @default(now()) @map("requested_at")
  processedAt   DateTime?        @map("processed_at")
  processedById Int?             @map("processed_by")
  processedBy   User?            @relation("WithdrawalProcessedBy", fields: [processedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key   String @id
  value Json

  @@map("app_settings")
}
